{
  "name": "bugbounty-hunter",
  "version": "1.0.0",
  "private": true,
  "description": "BugBounty Hunter - Open-Source AI Bug Reproduction, Investigation & Evidence Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "lint": "npm --prefix apps/web run lint",
    "test:web": "npm --prefix apps/web test",
    "test:api": "python -m pytest apps/api/tests",
    "test:fixture": "python -m pytest fixtures/sample-buggy-repo",
    "test": "npm run test:api && npm run test:fixture"
  },
  "keywords": [
    "bug-reproduction",
    "ai-agent",
    "proof-pack",
    "developer-tools",
    "pytest",
    "threejs"
  ],
  "author": "BugBounty Hunter Maintainers",
  "license": "MIT"
}
