# BugBounty Hunter Environment Configuration Example

# API Configuration
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="BugBounty Hunter API"

# Database: SQLite for local / fallback, PostgreSQL supported via standard DSN
DATABASE_URL=sqlite+aiosqlite:///./data/bugbounty.db

# Model Inference (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL_NAME=qwen2.5-coder:7b
MODEL_TIMEOUT_SECONDS=45

# Sandbox Execution Engine: 'auto', 'docker', or 'isolated_process'
SANDBOX_BACKEND=auto
MAX_ATTEMPTS=3
PER_TEST_TIMEOUT_SECONDS=30
MEMORY_LIMIT_MB=512

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
